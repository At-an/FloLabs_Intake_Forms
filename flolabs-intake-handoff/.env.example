# Copy to .env.local and fill in. Never commit .env.local.
TWENTY_BASE_URL=https://157-230-82-204.sslip.io
TWENTY_API_KEY=

# Cloudflare Turnstile (T7). Required in production (`next start`); in development the app
# falls back to Cloudflare's public test keys, which always pass.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Header with the real client IP when behind a proxy (rate limits). Behind Cloudflare use
# cf-connecting-ip. Leave unset locally.
# TRUSTED_IP_HEADER=cf-connecting-ip

# Revised POC:
# LINK_TOKEN_SECRET=         (T10)
