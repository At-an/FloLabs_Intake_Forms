# Copy to .env.local and fill in. Never commit .env.local.
TWENTY_BASE_URL=https://157-230-82-204.sslip.io
TWENTY_API_KEY=

# Cloudflare Turnstile (T7). Required in production (`next start`); in development the app
# falls back to Cloudflare's public test keys, which always pass.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Header with the real client IP set by your proxy (rate limits). REQUIRED in production:
# cf-connecting-ip behind Cloudflare, x-real-ip or x-forwarded-for behind nginx/Caddy. Leave
# unset locally.
# TRUSTED_IP_HEADER=cf-connecting-ip

# Signs the Form 1-3 links (T10). REQUIRED in production; at least 32 random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Changing it cancels every link not used yet.
# LINK_TOKEN_SECRET=
